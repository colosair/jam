{
  "name": "@jam-mcp/launcher",
  "version": "1.0.0",
  "description": "JAM launcher - resolves which JAM runtime to run and dispatches to it",
  "type": "module",
  "bin": {
    "jam-launcher": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config.d.ts",
      "default": "./dist/runtime-config.js"
    },
    "./runtime-resolver": {
      "types": "./dist/runtime-resolver.d.ts",
      "default": "./dist/runtime-resolver.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "UNLICENSED"
}
