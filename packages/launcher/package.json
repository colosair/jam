{
  "name": "@jam-mcp/launcher",
  "version": "1.4.3",
  "description": "JAM launcher - resolves which JAM runtime to run and dispatches to it",
  "keywords": [
    "jira",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "launcher"
  ],
  "homepage": "https://github.com/colosair/jam#readme",
  "bugs": {
    "url": "https://github.com/colosair/jam/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colosair/jam.git",
    "directory": "packages/launcher"
  },
  "author": "colosair (https://github.com/colosair)",
  "type": "module",
  "bin": {
    "jam": "dist/cli.js",
    "jam-launcher": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config.d.ts",
      "default": "./dist/runtime-config.js"
    },
    "./runtime-resolver": {
      "types": "./dist/runtime-resolver.d.ts",
      "default": "./dist/runtime-resolver.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "@jam-mcp/server": "1.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
