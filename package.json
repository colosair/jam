{
  "name": "jam-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "JAM (Jira Agent MCP) - workspace root",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "pack:all": "node scripts/pack-all.mjs",
    "smoke": "node scripts/tarball-smoke.mjs",
    "doctor": "node packages/server/dist/index.js doctor",
    "serve": "node packages/server/dist/index.js serve"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "UNLICENSED"
}
