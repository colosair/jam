# Reference values for the JIRA_* environment overrides.
#
# JAM does not read this file, and does not load .env at all. Credentials
# normally live in your OS secret store, put there by `auth login`; these
# variables are an explicit override for CI and for setups that already export
# them, and they win over the stored credentials when set.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
