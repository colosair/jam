# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# credentials / secrets
.env
.env.*
!.env.example

# local runtime state
.jira-agent/cache/
*.local.db
logs/
*.log

# un-redacted local material: raw benchmark output, scratch analysis.
# Anything here may contain identifiers or credentials and must never be committed.
private/

# This repo's own dogfooding config names a real Jira project. The tracked
# template is .jira-agent/project.yaml.example; project repos SHOULD commit
# their own project.yaml. Note this ignores the one file, not .jira-agent/.
.jira-agent/project.yaml

# JAM's default scope is personal: `jam setup` writes nothing into a
# repository, and JAM's own repository is not an exception. A maintainer wires
# their checkout up through their own MCP config and ~/.jam/config.yaml, so
# anything that lands here is one machine's local state, not this project's.
.mcp.json

# editors / OS
.DS_Store
.idea/
.vscode/
