{
  "name": "@jam-mcp/server",
  "version": "1.4.1",
  "description": "JAM (Jira Agent MCP) - agent-facing Jira access layer: MCP server, setup core, and CLI",
  "keywords": [
    "jira",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "jira-api"
  ],
  "homepage": "https://github.com/colosair/jam#readme",
  "bugs": {
    "url": "https://github.com/colosair/jam/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colosair/jam.git",
    "directory": "packages/server"
  },
  "author": "colosair (https://github.com/colosair)",
  "type": "module",
  "bin": {
    "jam-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jam-mcp/launcher": "1.4.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli-entry": {
      "types": "./dist/cli-entry.d.ts",
      "default": "./dist/cli-entry.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
